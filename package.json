{
  "name": "qmenut",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build --concurrency=2",
    "check": "turbo check --concurrency=1",
    "test:e2e": "bun run --cwd e2e test",
    "audit": "bun audit --audit-level=high",
    "lint": "bun run lint:prettier && bun run lint:eslint",
    "lint:prettier": "prettier --check .",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:fix": "prettier --write . && bun run lint:eslint:fix",
    "format": "prettier --write ."
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "eslint": "^10.7.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^71.1.0",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
