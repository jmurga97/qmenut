{
  "name": "qmenut",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build --concurrency=2",
    "check": "turbo check --concurrency=1",
    "test": "bun test packages/ui",
    "test:e2e": "bun run --cwd e2e test",
    "lint": "oxfmt --check . && prettier --check \"apps/landing/**/*.astro\" && oxlint . --deny-warnings",
    "lint:fixtures": "bun scripts/lint-fixtures.ts",
    "format": "oxfmt && prettier --write \"apps/landing/**/*.astro\"",
    "format:check": "oxfmt --check . && prettier --check \"apps/landing/**/*.astro\"",
    "db:generate": "bun run --cwd apps/api db:generate --",
    "prepare": "husky"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@happy-dom/global-registrator": "^20.14.0",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-wc": "^3.1.0",
    "husky": "^9.1.7",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^1.0.0",
    "turbo": "^2.10.5"
  }
}
