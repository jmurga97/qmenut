# Build-time API origin. Production builds must set this to the public API URL; SSR requests
# use the API_WORKER binding, while browsers use this value for direct tRPC requests.
VITE_API_BASE_URL=http://localhost:8787

CLOUDGLARE_ENV=
# Client-side Sentry DSN. Leave empty to disable browser error reporting.
VITE_SENTRY_DSN=

# PostHog EU project key. Leave empty to disable anonymous analytics.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
