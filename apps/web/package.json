{
  "name": "@qmenut/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "VITE_ADMIN_ORIGIN=https://admin.qmenut.app CLOUDFLARE_ENV=production vite build && wrangler deploy",
    "deploy:development": "VITE_ADMIN_ORIGIN=https://admin.dev.qmenut.app CLOUDFLARE_ENV=development vite build && wrangler deploy",
    "serve": "wrangler dev --port 4011 --persist-to ../../.wrangler-shared/state"
  },
  "dependencies": {
    "@lit-labs/ssr-react": "^0.3.4",
    "@qmenut/api": "workspace:*",
    "@qmenut/db": "workspace:*",
    "@qmenut/ui": "workspace:*",
    "@sentry/cloudflare": "^10.63.0",
    "@sentry/react": "^10.63.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.26",
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0",
    "@trpc/tanstack-react-query": "11.18.0",
    "i18next": "^26.3.4",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.6",
    "posthog-js": "^1.398.0",
    "react": "canary",
    "react-dom": "canary",
    "react-i18next": "^17.0.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/workers-types": "^4.20260701.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wrangler": "4.118.0"
  }
}
