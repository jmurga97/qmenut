{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qmenut-tenant-config",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "workers_dev": false,
  // The production id must match apps/web/wrangler.jsonc. Local state uses the shared preview_id.
  "kv_namespaces": [
    {
      "binding": "TENANT_THEME",
      "id": "0f5d31e6c4a94b0f8a2d7c1b3e9f6a01",
      "preview_id": "0f5d31e6c4a94b0f8a2d7c1b3e9f6a01",
    },
  ],
  "observability": {
    "enabled": true,
  },
  // Wrangler named environments do not inherit KV bindings or observability. Keep name
  // unchanged so the API's THEME_WORKER service binding resolves this worker.
  "env": {
    "development": {
      "name": "qmenut-tenant-config-dev",
      "kv_namespaces": [
        {
          "binding": "TENANT_THEME",
          "id": "d85019d6ce874b2abdedeb95a91736a3",
        },
      ],
      "observability": {
        "enabled": true,
      },
    },
    "production": {
      "name": "qmenut-tenant-config",
      "kv_namespaces": [
        {
          "binding": "TENANT_THEME",
          "id": "48d5fae2045240cfae007bdd790c64f6",
        },
      ],
      "observability": {
        "enabled": true,
      },
    },
  },
}
