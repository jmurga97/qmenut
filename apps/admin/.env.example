# Build-time API origin used by the admin browser client.
VITE_API_BASE_URL=http://localhost:8787

# Optional local public-menu port. Defaults to Vite's 5173; E2E uses the Worker on 4011.
VITE_PUBLIC_MENU_PORT=5173

# Client-side Sentry DSN. Leave empty to disable error reporting (e.g. local dev).
VITE_SENTRY_DSN=
