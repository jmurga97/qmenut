{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qmenut-admin",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Wrangler named environments do not inherit assets. Keep name unchanged so the
  // admin.qmenut.app custom domain remains attached to qmenut-admin.
  "env": {
    "development": {
      "name": "qmenut-admin-dev",
      "routes": [
        {
          "pattern": "admin.dev.qmenut.app",
          "custom_domain": true,
        },
      ],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
      },
      "observability": {
        "enabled": true,
      },
    },
    "production": {
      "name": "qmenut-admin",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
      },
      "observability": {
        "enabled": true,
      },
    },
  },
}
