{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "paths": {
      "~/*": ["./src/*"],
      "~/app/*": ["./src/app/*"],
      "~/features/*": ["./src/features/*"],
      "~/lib/*": ["./src/lib/*"],
      "~/shared/*": ["./src/shared/*"]
    },
    "types": ["vite/client"],
    "useDefineForClassFields": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
