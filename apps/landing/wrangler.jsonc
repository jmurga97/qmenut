{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qmenut-landing",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // Wrangler named environments do not inherit assets or observability. Keep the name
  // unchanged so the apex/www custom domains remain attached to qmenut-landing.
  "env": {
    "production": {
      "name": "qmenut-landing",
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
      },
      "observability": {
        "enabled": true,
      },
    },
  },
}
