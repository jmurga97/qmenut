---
import "../styles/fonts.css";
import "@jmurga97/components/styles.css";
import "../styles/landing.css";
import type { MarketId } from "../lib/markets";
import { adminUrl, markets } from "../lib/markets";
interface Props {
  title: string;
  description: string;
  market?: MarketId;
  page?: "" | "precios" | "empezar";
  neutral?: boolean;
  noindex?: boolean;
}
const { title, description, market, page = "", neutral = false, noindex = false } = Astro.props;
const path = market ? `/${market}/${page}` : "/";
const url = (path: string) => new URL(path, "https://qmenut.app").href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": url("/#organization"), name: "Qmenut", url: url("/") },
    {
      "@type": "WebSite",
      "@id": url("/#website"),
      name: "Qmenut",
      url: url("/"),
      publisher: { "@id": url("/#organization") },
    },
    ...(market && page === "precios"
      ? [
          {
            "@type": "SoftwareApplication",
            name: "Qmenut",
            applicationCategory: "BusinessApplication",
            operatingSystem: "Web",
            description,
            url: url(path),
            offers: markets[market].plans.map((plan) => ({
              "@type": "Offer",
              name: plan.name,
              price: plan.price,
              priceCurrency: markets[market].currency,
              priceSpecification: {
                "@type": "UnitPriceSpecification",
                price: plan.price,
                priceCurrency: markets[market].currency,
                unitText: "MONTH",
                valueAddedTaxIncluded: false,
              },
              url: url(path),
            })),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="es" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url(market || neutral ? path : Astro.url.pathname)} />
    <meta property="og:image" content={url("/assets/og.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {market && <meta property="og:locale" content={market === "es" ? "es_ES" : "es_VE"} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
    {(noindex || Astro.url.hostname === "landing.dev.qmenut.app") && <meta name="robots" content="noindex" />}
    {(market || neutral) && <link rel="canonical" href={url(path)} />}
    {!noindex && (market || neutral) && (
      <>
        <link rel="alternate" hreflang="es-ES" href={url(`/es/${page}`)} />
        <link rel="alternate" hreflang="es-VE" href={url(`/ve/${page}`)} />
        {page === "" && <link rel="alternate" hreflang="x-default" href={url("/")} />}
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistPixel-Line.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <header class="site-nav">
      <div class="container">
        <a class="brand" href={market ? `/${market}/` : "/"}>
          Qmenut
        </a>
        <nav aria-label="Principal">
          {market && (
            <>
              <a href={`/${market}/#funcionalidades`}>Funcionalidades</a>
              <a href={`/${market}/#demos`}>Demos</a>
              <a href={`/${market}/precios`}>Precios</a>
            </>
          )}
          <a href={adminUrl}>Entrar</a>
        </nav>
        <nav aria-label="País" class="country-nav">
          {(["es", "ve"] as const).map((id) => (
            <a href={`/${id}/${page}`} aria-current={market === id ? "page" : undefined}>
              {markets[id].country}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="container site-footer">
      <span>© {new Date().getFullYear()} Qmenut</span>
      <nav aria-label="Pie de página">
        {market && <a href={`/${market}/precios`}>Precios</a>}
        <a href={adminUrl}>Entrar</a>
      </nav>
    </footer>
  </body>
</html>
