---
import { PLANS } from "../lib/content";
---

<ul class="grid plans">
  {PLANS.map((plan) => (
    <li class:list={{ featured: plan.name === "Business" }}>
      <h3>{plan.name}</h3>
      {plan.price ? (
        <p class="figure">
          {plan.price} <small>/ mes</small>
        </p>
      ) : (
        <p class="figure">
          <small>Próximamente</small>
        </p>
      )}
      <ul>
        {plan.highlights.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </li>
  ))}
</ul>
