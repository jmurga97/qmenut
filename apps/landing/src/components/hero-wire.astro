---
// The menu as a wireframe of its own components, on the geometry of the real capture (% of 390 × 700).
// It starts lying flat; the first scroll lifts each component off the page, the same sheets the story then prints.
type Part = [kind: "box" | "line" | "photo", x: number, y: number, w: number, h: number];
type Layer = { label: string; z: number; from?: number; tag: [x: number, y: number]; block?: number[]; parts: Part[] };
const row = (y: number): Part[] => [
  ["box", 4.6, y, 90.8, 11],
  ["photo", 7, y + 1.7, 13.5, 7.5],
  ["line", 25, y + 2, 35, 1.6],
  ["line", 25, y + 5, 45, 1],
  ["line", 25, y + 7.2, 36, 1],
  ["line", 81, y + 3.4, 11, 1.6],
];
// Top of the stack first: the order they lift in.
const layers: Layer[] = [
  {
    label: "Cabecera",
    z: 7,
    tag: [0, 4],
    parts: [
      ["line", 5, 3.6, 30, 1.4],
      ["line", 76, 3.3, 15, 1.8],
      ["line", 5, 7.2, 56, 4.8],
      ["line", 5, 13.2, 58, 1.4],
      ["line", 5, 16.8, 90, 0.4],
    ],
  },
  {
    label: "Destacado",
    z: 6,
    tag: [100, 21],
    parts: [
      ["box", 4.6, 19.5, 90.8, 23],
      ["photo", 71, 19.5, 24.4, 23],
      ["line", 9, 24, 22, 2.4],
      ["line", 9, 28.6, 40, 3.4],
      ["line", 9, 33.6, 52, 1.2],
      ["line", 9, 36, 30, 1.2],
      ["line", 9, 39.4, 14, 2],
    ],
  },
  {
    label: "Categorías",
    z: 5,
    tag: [0, 46],
    parts: [
      ["box", 4.6, 46, 34.4, 6.5],
      ["line", 10, 48.5, 23, 1.4],
      ["box", 41, 46, 34.4, 6.5],
      ["line", 46.5, 48.5, 23, 1.4],
      ["box", 77.4, 46, 18, 6.5],
    ],
  },
  {
    label: "Sección",
    z: 4,
    tag: [100, 63],
    parts: [
      ["box", 4.6, 58, 90.8, 6.5],
      ["line", 8, 59.8, 7, 3],
      ["line", 18, 59.8, 40, 3],
      ["line", 80, 60.6, 11, 1.4],
    ],
  },
  { label: "Plato", z: 2, tag: [0, 67], parts: [...row(67), ...row(80)] },
  {
    label: "Ficha del plato",
    z: 3,
    from: 2,
    tag: [112, 28],
    // Left, top, width, height on the page; the parts inside are % of this card.
    block: [30, 33, 82, 52],
    parts: [
      ["box", 0, 0, 100, 100],
      ["photo", 0, 0, 100, 46],
      ["line", 6, 52, 30, 4],
      ["line", 6, 60, 56, 5],
      ["line", 6, 69, 82, 2],
      ["line", 6, 73.5, 66, 2],
      ["line", 6, 80, 20, 3.4],
      ["box", 6, 88, 26, 6],
      ["box", 36, 88, 26, 6],
    ],
  },
  {
    label: "Navegación",
    z: 1,
    tag: [0, 92],
    parts: [["box", 0, 91, 100, 9], ...[0, 1, 2, 3].map((index): Part => ["line", 9.5 + index * 25, 92.8, 6, 3.4])],
  },
];
const at = (part: Part) => `--x: ${part[1]}%; --y: ${part[2]}%; --w: ${part[3]}%; --h: ${part[4]}%`;
---

<div class="wire" aria-hidden="true">
  <div class="wire-model">
    <div class="wire-layer wire-page"></div>
    {layers.map((layer, index) => (
      <div
        class:list={["wire-layer", { "wire-layer--card": layer.block }]}
        style={`--z: ${layer.z}; --from: ${layer.from ?? 0}; --at: ${index}`}
      >
        <div
          class="wire-block"
          style={
            layer.block &&
            `--x: ${layer.block[0]}%; --y: ${layer.block[1]}%; --w: ${layer.block[2]}%; --h: ${layer.block[3]}%`
          }
        >
          {layer.parts.map((part) => (
            <i class={`w-${part[0]}`} style={at(part)} />
          ))}
        </div>
        <span class="wire-tag" style={`--x: ${layer.tag[0]}%; --y: ${layer.tag[1]}%`}>
          {layer.label}
        </span>
      </div>
    ))}
  </div>
</div>
