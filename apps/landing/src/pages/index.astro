---
import BaseLayout from "../layouts/base-layout.astro";
import { marketFromRequest } from "../lib/markets";

// Visitors from a known market skip the chooser; crawlers and everyone else still see it.
const market = marketFromRequest(Astro.request);
if (market) return Astro.redirect(`/${market}/`, 302);
---

<BaseLayout
  title="Qmenut · Elige tu país"
  description="Descubre Qmenut para tu restaurante en España o Venezuela."
  neutral
>
  <section class="container hero">
    <h1>Tu restaurante en Qmenut</h1>
    <p>Elige tu país para conocer los planes y funcionalidades.</p>
    <div class="actions">
      <a class="button" href="/es/">
        España
      </a>
      <a class="text-link" href="/ve/">
        Venezuela
      </a>
    </div>
  </section>
</BaseLayout>
