---
import { SignupForm } from "../../components/signup/signup-form";
import BaseLayout from "../../layouts/base-layout.astro";
import { markets } from "../../lib/markets";
import type { MarketId } from "../../lib/markets";
const market = Astro.params.market as MarketId;
if (!Object.hasOwn(markets, market)) return new Response(null, { status: 404 });
const content = markets[market];
---

<BaseLayout
  market={market}
  page="empezar"
  noindex
  title={`Prueba gratis · Qmenut ${content.country}`}
  description={content.description}
>
  <section class="container hero">
    <h1>Tu web en 3 pasos, gratis 14 días</h1>
    <p>Plan Business completo, sin tarjeta. Al terminar la prueba eliges si sigues.</p>
    <SignupForm client:only="react" market={market} />
    <p>
      ¿Prefieres que lo hagamos contigo?{" "}
      <a class="text-link" href={content.whatsapp.contact}>
        Escríbenos por WhatsApp
      </a>
    </p>
  </section>
</BaseLayout>
