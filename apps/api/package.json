{
  "name": "@qmenut/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./router": {
      "types": "./src/trpc/router.ts",
      "import": "./src/trpc/router.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev --port 8787 --inspector-port 9230 --var NODE_ENV:development --var DEV_FIXED_OTP:true",
    "dev:e2e": "bash ../../e2e/scripts/start-api.sh",
    "build": "wrangler types && tsc --noEmit",
    "check": "tsc --noEmit && bun run db:check",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate:custom": "drizzle-kit generate --config drizzle.config.ts --custom",
    "db:check": "drizzle-kit check --config drizzle.config.ts && bun scripts/check-db-migrations.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file",
    "kv:seed:local": "wrangler kv key put tapas.localhost --path seed/tenant-theme/tapas.localhost.json --binding TENANT_THEME --preview --local && wrangler kv key put fine.localhost --path seed/tenant-theme/fine.localhost.json --binding TENANT_THEME --preview --local && wrangler kv key put cafe.localhost --path seed/tenant-theme/cafe.localhost.json --binding TENANT_THEME --preview --local && wrangler kv key put her.localhost --path seed/tenant-theme/her.localhost.json --binding TENANT_THEME --preview --local && wrangler kv key put fast.localhost --path seed/tenant-theme/fast.localhost.json --binding TENANT_THEME --preview --local",
    "db:cleanup:e2e": "wrangler d1 execute DB --local --file ../../e2e/seed/cleanup-e2e.sql"
  },
  "dependencies": {
    "@qmenut/auth": "workspace:*",
    "@qmenut/db": "workspace:*",
    "@qmenut/permissions": "workspace:*",
    "@qmenut/ui": "workspace:*",
    "@sentry/cloudflare": "^10.63.0",
    "@trpc/server": "11.18.0",
    "drizzle-orm": "0.44.7",
    "stripe": "22.4.0",
    "xss": "^1.0.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260502.0",
    "@types/bun": "^1.3.6",
    "@types/node": "^26.0.1",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2",
    "wrangler": "4.151.3"
  }
}
