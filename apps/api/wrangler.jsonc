{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qmenut-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qmenut-db-v2",
      "database_id": "2bb09db5-d6c8-477c-bf19-040a471ff879",
      "migrations_dir": "migrations",
    },
  ],
  "services": [
    {
      "binding": "EMAIL_WORKER",
      "service": "ming-email-worker",
      "remote": true,
    },
    {
      "binding": "IMAGE_WORKER",
      "service": "ming-image-worker",
      "entrypoint": "ImageRpc",
      "remote": true,
    },
    {
      "binding": "THEME_WORKER",
      "service": "qmenut-tenant-config",
    },
  ],
  "ratelimits": [
    {
      "name": "GEOCODING_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    {
      "name": "PUBLIC_REVIEWS_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "LOYALTY_CODE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5174,http://tapas.localhost:5173,http://fine.localhost:5173,http://cafe.localhost:5173,http://her.localhost:5173,http://fast.localhost:5173,http://tapas.localhost:4011,http://fine.localhost:4011,http://cafe.localhost:4011,http://her.localhost:4011,http://fast.localhost:4011",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "ADMIN_APP_URL": "http://localhost:5174",
    "DEEPL_API_URL": "https://api-free.deepl.com",
    "POSTHOG_API_HOST": "https://eu.posthog.com",
    "STRIPE_PRICE_BASIC": "price_1U120eEnGfbzQ006un87QMk4",
    "LOG_LEVEL": "info",
    "NODE_ENV": "production",
    "SENTRY_DSN": "",
  },
  // Wrangler named environments do not inherit vars, D1, services, rate limits, or
  // observability. Keep name unchanged so service bindings continue to resolve qmenut-api.
  "env": {
    "development": {
      "name": "qmenut-api-dev",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "api.dev.qmenut.app",
          "custom_domain": true,
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "qmenut-db-v2-dev",
          "database_id": "f83a9c25-39a3-4003-80f5-633a6b9de41b",
          "migrations_dir": "migrations",
        },
      ],
      "services": [
        {
          "binding": "EMAIL_WORKER",
          "service": "ming-email-worker",
          "remote": true,
        },
        {
          "binding": "IMAGE_WORKER",
          "service": "ming-image-worker",
          "entrypoint": "ImageRpc",
          "remote": true,
        },
        {
          "binding": "THEME_WORKER",
          "service": "qmenut-tenant-config-dev",
        },
      ],
      "ratelimits": [
        {
          "name": "GEOCODING_LIMITER",
          "namespace_id": "2002",
          "simple": {
            "limit": 30,
            "period": 60,
          },
        },
        {
          "name": "PUBLIC_REVIEWS_LIMITER",
          "namespace_id": "2003",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
        {
          "name": "LOYALTY_CODE_LIMITER",
          "namespace_id": "2001",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
      ],
      "observability": {
        "enabled": true,
      },
      "vars": {
        "ALLOWED_ORIGINS": "https://admin.dev.qmenut.app",
        "BETTER_AUTH_URL": "https://api.dev.qmenut.app",
        "ADMIN_APP_URL": "https://admin.dev.qmenut.app",
        "DEEPL_API_URL": "https://api-free.deepl.com",
        "STRIPE_PRICE_BASIC": "price_1U120eEnGfbzQ006un87QMk4",
        "LOG_LEVEL": "debug",
        "NODE_ENV": "development",
        "DEV_FIXED_OTP": "true",
        "SENTRY_DSN": "https://b201dd7421ecf64b6b7c2f073bae0cf0@o4511851717394432.ingest.de.sentry.io/4511956009943120",
      },
    },
    "production": {
      "name": "qmenut-api",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "api.qmenut.app",
          "custom_domain": true,
        },
      ],
      // Único Cron Trigger de producción: sincroniza PostHog → D1 y envía el digest
      // quincenal. Development no tiene cron.
      "triggers": {
        "crons": ["45 4 * * *"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "qmenut-db-v2",
          "database_id": "2bb09db5-d6c8-477c-bf19-040a471ff879",
          "migrations_dir": "migrations",
        },
      ],
      "services": [
        {
          "binding": "EMAIL_WORKER",
          "service": "ming-email-worker",
          "remote": true,
        },
        {
          "binding": "IMAGE_WORKER",
          "service": "ming-image-worker",
          "entrypoint": "ImageRpc",
          "remote": true,
        },
        {
          "binding": "THEME_WORKER",
          "service": "qmenut-tenant-config",
        },
      ],
      "ratelimits": [
        {
          "name": "GEOCODING_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 30,
            "period": 60,
          },
        },
        {
          "name": "PUBLIC_REVIEWS_LIMITER",
          "namespace_id": "1003",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
        {
          "name": "LOYALTY_CODE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
      ],
      "observability": {
        "enabled": true,
      },
      "vars": {
        "ALLOWED_ORIGINS": "https://admin.qmenut.app",
        "BETTER_AUTH_URL": "https://api.qmenut.app",
        "ADMIN_APP_URL": "https://admin.qmenut.app",
        "DEEPL_API_URL": "https://api-free.deepl.com",
        "POSTHOG_API_HOST": "https://eu.posthog.com",
        "STRIPE_PRICE_BASIC": "price_1U120eEnGfbzQ006un87QMk4",
        "LOG_LEVEL": "info",
        "NODE_ENV": "production",
        "SENTRY_DSN": "https://b201dd7421ecf64b6b7c2f073bae0cf0@o4511851717394432.ingest.de.sentry.io/4511956009943120",
        "DEV_FIXED_OTP": "false",
      },
    },
  },
}
